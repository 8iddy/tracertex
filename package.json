{
  "name": "tracertext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "workerd": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:types": "wrangler types",
    "cf:check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply tracertext --local"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@lexical/list": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/rich-text": "0.51.0",
    "@lexical/selection": "0.51.0",
    "@lexical/utils": "0.51.0",
    "lexical": "0.51.0",
    "lucide-react": "0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@eslint/js": "9.38.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "fake-indexeddb": "6.2.4",
    "globals": "16.4.0",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12",
    "vitest": "4.0.8",
    "wrangler": "^4.135.0"
  }
}
