{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tracertext",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "access": {
    "dev": {
      "aud": "tracertext-local-development",
      "identity": {
        "email": "dev@tracertext.local",
        "name": "Local TracerText Developer"
      }
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracertext",
      "database_id": "fc3403b1-83f6-4f51-aff7-26eb847f0e81",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
